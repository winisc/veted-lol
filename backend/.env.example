# Copie este arquivo para .env e preencha.
# Chave de desenvolvimento: https://developer.riotgames.com (expira a cada 24h)
RIOT_API_KEY=

# Troque em produção
JWT_SECRET=

PORT=3333

# Riot IDs com acesso à tela de admin, separados por vírgula (ex.: Wini#deus,Outro#BR1).
# Outros admins podem ser promovidos pela própria tela.
ADMIN_RIOT_IDS=

# Backup automático do banco: uma cópia por dia. No Docker, o padrão é /data/backups (dentro do volume).
# Vale copiar a pasta de vez em quando para outro lugar: o volume e o backup ficam no mesmo disco.
# BACKUP_DIR=
# Quantas cópias manter (padrão 14).
# BACKUP_KEEP=14
# Para desligar o backup automático:
# BACKUP_ENABLED=false
